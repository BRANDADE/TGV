{
    // ==========================================
    // TRGT genotype parameters
    // ==========================================
    "genotype": {

        // Sample karyotype
        // Default TRGT: "XX"
        //"karyotype": "XX",

        // Preset: "wgs" or "targeted"
        // Default TRGT: "wgs" (src/cli.rs) — "targeted" est requis pour PureTarget
        "preset": "targeted",

        // Verbosity level
        // Default TRGT: 0 (no -v)
        // 1 = -v
        // 2 = -vv
        "verbose": 0,

        // Color output: "auto", "always", "never"
        // Default TRGT: "auto"
        "color": "auto",

        // Genotyping algorithm: "size" or "cluster"
        //"genotyper": "size",

        // Minimum flanking sequence length
        //"flank-len": 300,

        // Maximum locus depth
        //"max-depth": 250,

        // Output flanking sequence length
        //"output-flank-len": 50

        // Minimum read quality (rq). OBLIGATOIRE si un BAM de fail reads est fourni
        // (4e colonne de la liste d'échantillons) : --fail-reads désactive sinon le
        // filtre de qualité par défaut de TRGT (TRGT >= 5.1.0, CHANGELOG).
        //"min-read-quality": 0.98,
    },

    // ==========================================
    // TRGT plot parameters
    // ==========================================
    "plot": {

        // Mode de génération des graphiques
        // Options: "all", "meth", "allele", "waterfall", "motifs"
        "plot_mode": "all",

        // Niveau de verbosité
        // 0 = standard, 1 = -v, 2 = -vv
        "verbose": 0,

        // Compresse horizontalement le graphique (true/false)
        "squished": false,

        // Police d'écriture pour les textes
        "font-family": "Roboto Mono",

        // Option d'affichage des couleurs dans les logs: "always", "auto", "never"
        "color": "auto",

        // Taille des régions flanquantes (entier >= 0)
        "flank-len": 50,

        // Nombre max de lectures par allèle à tracer (entier >= 0)
        "max-allele-reads": 100
    },


    // ==========================================
    // QC legend parameters
    // ==========================================    
    "coverage_thresholds": {
        "high": 50,
        "medium": 10
    },

    "coverage_colors": {
        "high": "#baffc9",
        "medium": "#ffdfba",
        "low": "#ffb3ba"
    },

    "coverage_labels": {
        "high": "Min Allele Coverage >= {high}X",
        "medium": "Min Allele Coverage {medium}X - {high_minus_1}X",
        "low": "Min Allele Coverage < {medium}X"
    }
}
